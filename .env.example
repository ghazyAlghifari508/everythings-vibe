# === WEB + workers: PostgreSQL connection (never expose this port publicly) ===
DATABASE_URL="postgresql://novaplan:novaplan_local@localhost:5432/novaplan"

# === WEB: Better Auth ===
# Generate: npx @better-auth/cli secret  (or openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# === WEB: Google OAuth (Better Auth social provider) ===
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === WEB: GitHub OAuth (Better Auth social provider) ===
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# === WEB + Studio/Codebase workers: AI gateway (9router — local, no key) ===
NINE_ROUTER_URL="http://localhost:20128"
# Optional gateway credential, only supplied to AI-using workers/web.
NINE_ROUTER_API_KEY=""

# === WEB: Midtrans (payments) ===
# Gateway environment: sandbox default. Set to production with
# MIDTRANS_SERVER_KEY to cut over; missing credentials fail closed.
MIDTRANS_ENVIRONMENT="sandbox"
MIDTRANS_SERVER_KEY_SANDBOX=""
MIDTRANS_CLIENT_KEY_SANDBOX=""
MIDTRANS_SERVER_KEY=""

# === WEB: Email (Resend) ===
RESEND_API_KEY=""
FEEDBACK_EMAIL=""
# Sender identity for billing emails, e.g. "NovaPlan <billing@yourdomain.com>"
EMAIL_FROM=""
# === WEB + billing-scheduler profile: authenticated scheduler ===
# Shared secret for GET /api/cron/billing. Invoked via standalone scheduler
# (cron/systemd timer/container) with "Authorization: Bearer $CRON_BILLING_SECRET".
# Generate with: openssl rand -hex 32
CRON_BILLING_SECRET=""
# Optional custom endpoint URL for scripts/run-billing-cron.ts (defaults to $APP_URL/api/cron/billing)
BILLING_CRON_URL=""

# === WEB: App ===
# Optional for Compose Caddy: set to a real DNS name only after it resolves to this host.
DOMAIN="localhost"
# Use the public HTTPS origin in production; local Compose proxy uses http://localhost.
APP_URL="http://localhost:3000"
LOG_LEVEL="debug"

# Automatic Greenfield handoff keys: 30 days accommodates multi-phase work and
# human checkpoints. Integer days clamped to 1..90; invalid values use 30.
# Re-handoff mints a fresh key without changing existing keys or renewing them.
AUTO_API_KEY_TTL_DAYS="30"
# Explicit Settings cleanup only: legacy automatic keys without expiry receive
# this deadline (hours clamped to 0..168, default 72). Manual keys are unchanged.
AUTO_API_KEY_SUPERSEDE_GRACE_HOURS="72"

# === Context7 MCP (AI grounding — no key) ===
# Required for grounding; missing value degrades generation to its existing behavior.
CONTEXT7_MCP_URL="https://mcp.context7.com/mcp"

# Comma-separated emails auto-promoted to admin on login (OAuth-verified)
ADMIN_EMAILS="alghifarighazy508@gmail.com"
